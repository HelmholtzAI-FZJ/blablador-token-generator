FROM postgres:18-alpine@sha256:77f585114c32fbca283dc835b0596f4e52b51b4c6662d7810b2f4084f60a1873

# Security updates published for this Alpine release since the base image
# was built (exact versions would break the build once Alpine moves on);
# gosu is unused because the container never starts as root.
RUN apk upgrade --no-cache \
    && rm -f /usr/local/bin/gosu
USER 70
