# Redis 7.4 is built only on Alpine 3.21, which reaches end of support on
# 2026-11-01; Redis 8 (Alpine 3.23) speaks the same protocol and ACLs.
FROM redis:8.10.2-alpine@sha256:9f8d2d789b9a1d1e3f283f979aa9cbf393373806472e1ccd460e2f9c869b833b

# Security updates published for this Alpine release since the base image
# was built. The rate limiter needs plain Redis: drop the bundled modules
# (search, JSON, time series, probabilistic) the image's entrypoint loads.
RUN apk upgrade --no-cache \
    && rm -rf /usr/local/lib/redis/modules
USER 999
