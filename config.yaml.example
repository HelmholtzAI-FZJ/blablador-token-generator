# Token Generator Service Configuration

app:
  name: "Token Generator"
  host: "0.0.0.0"
  port: 8080
  # REQUIRED: Set a strong, unique secret key for JWT signing.
  # The application will refuse to start with default/weak values.
  # Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
  secret_key: "REPLACE_WITH_GENERATED_SECRET_KEY_AT_LEAST_32_CHARS_LONG"
  # REQUIRED: separate key for hashing stored API tokens (must differ from
  # secret_key), so rotating secret_key does not invalidate API tokens.
  # Env override: TOKEN_HASH_KEY. Never change it once tokens exist.
  token_hash_key: "REPLACE_WITH_A_DIFFERENT_GENERATED_KEY_AT_LEAST_32_CHARS"
  debug: false
  api_url: "http://localhost:8080"
  # Secure, __Host- prefixed cookies (default true). Set to false only for
  # local development over plain http, where browsers drop Secure cookies.
  secure_cookies: true
  # Level of the audit log (admin actions, logins, token changes) on stderr.
  log_level: "INFO"
  # Largest accepted request body in bytes (the ingress should match).
  max_body_bytes: 65536

database:
  url: "sqlite+aiosqlite:///./tokens.db"
  # Log SQL statements (parameters are never logged).
  echo: false

oauth:
  # OAuth2 configuration
  client_id: "your-client-id"
  client_secret: "your-client-secret"
  authorize_url: "https://login.jsc.fz-juelich.de/oauth2-as/oauth2-authz"
  token_url: "https://login.jsc.fz-juelich.de/oauth2/token"
  userinfo_url: "https://login.jsc.fz-juelich.de/oauth2/userinfo"
  redirect_uri: "http://localhost:8080/oauth/openid/callback"
  scopes:
    - "openid"
    - "profile"
    - "email"
  # Trust the provider's email claim without email_verified: true. Enable only
  # if the IdP guarantees every asserted email is verified.
  trust_provider_emails: false

# Display name for the login button
login:
  name: "JSC Login"
  description: "Authenticate with JSC Login to create and manage API tokens."

local:
  enabled: false
  allow_registration: false

tokens:
  # Token expiration settings
  # default_expiration_days: default duration for new tokens (UI default and API fallback)
  # max_expiration_days: maximum allowed expiration for any token (enforced by API)
  # token_prefix always shows up
  default_expiration_days: 90
  max_expiration_days: 365
  token_length_bytes: 32
  token_prefix: blablador

rate_limits:
  # Where counters are stored. "memory://" is per process, so with several
  # workers or replicas use Redis, e.g. "redis://:password@redis:6379/0".
  # Env override: RATE_LIMIT_STORAGE_URI.
  storage_uri: "memory://"
  # Unauthenticated endpoints, per client IP. Many users may share one
  # address (campus NAT, VPN, a course), so keep these generous.
  pages: "120/minute"
  oauth_callback: "60/minute"
  local_login: "10/minute"
  # Authenticated endpoints, per signed-in user.
  tokens_read: "60/minute"
  tokens_write: "30/minute"
  session: "30/minute"
  account_delete: "5/minute"
  admin: "120/minute"
  # POST /api/v1/auth/validate, per client IP. List the API gateway's
  # addresses or CIDRs in token_validation_exempt so its traffic is never limited.
  token_validation: "600/minute"
  token_validation_exempt: []

admin:
  # OAuth subject IDs ("sub") promoted to admin at login. Preferred: the
  # subject cannot be spoofed by choosing an email address.
  admin_subjects: []
  # Emails promoted to admin at login, only when the provider marks the email
  # verified (email_verified: true) or oauth.trust_provider_emails is true.
  admin_emails:
    - "admin@example.com"
    - "another-admin@example.com"