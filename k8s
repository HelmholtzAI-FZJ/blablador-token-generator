apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: token-generator-db
  labels:
    app: token-generator
spec:
  accessModes: [ReadWriteOnce]
  resources:
    requests:
      storage: 1Gi
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: token-generator
  labels:
    app: token-generator
spec:
  replicas: 2
  selector:
    matchLabels:
      app: token-generator
  template:
    metadata:
      labels:
        app: token-generator
    spec:
      containers:
        - name: app
          image: ghcr.io/helmholtzai-fzj/blablador-token-generator:latest
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: 8080
          volumeMounts:
            - name: config
              mountPath: /app/config
              readOnly: true
            - name: token-db
              mountPath: /app/data
          resources:
            requests:
              memory: "128Mi"
              cpu: "100m"
            limits:
              memory: "256Mi"
              cpu: "500m"
          livenessProbe:
            httpGet:
              path: /docs
              port: 8080
            initialDelaySeconds: 10
            periodSeconds: 30
          readinessProbe:
            httpGet:
              path: /docs
              port: 8080
            initialDelaySeconds: 5
            periodSeconds: 10
      volumes:
        - name: config
          secret:
            secretName: token-generator-config
        - name: token-db
          persistentVolumeClaim:
            claimName: token-generator-db
---
apiVersion: v1
kind: Service
metadata:
  name: token-generator
  labels:
    app: token-generator
spec:
  type: ClusterIP
  ports:
    - port: 80
      targetPort: 8080
      protocol: TCP
      name: http
  selector:
    app: token-generator
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: token-generator
  labels:
    app: token-generator
  annotations:
    nginx.ingress.kubernetes.io/proxy-body-size: "10m"
spec:
  rules:
    - host: tokens.example.com
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: token-generator
                port:
                  number: 80
  tls:
    - hosts:
        - tokens.example.com
      secretName: token-generator-tls